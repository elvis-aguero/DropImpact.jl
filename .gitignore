# Julia package convention: do not commit resolved Manifest.toml for a package repo
# (SpectralKM/derivations tooling) -- consumers resolve via Project.toml's [compat].
Manifest.toml

# LaTeX build artifacts
derivations/*.aux
derivations/*.log
derivations/*.out
derivations/*.toc
derivations/*.fls
derivations/*.fdb_latexmk
derivations/*.synctex.gz

# Local, machine-specific Claude Code settings
.claude/settings.local.json

.DS_Store

# rendered media: the README gif is tracked, full-resolution mp4s are not
output/media/*.mp4

# comparison-run outputs: regenerate with scripts/compare_experiments.jl
data/experiments/sim_cache_v2.csv
data/experiments/shard_*.csv
data/experiments/comparison*.svg

# Generated by scripts/compare_fluid_experiment.jl; CI uploads it as an artifact instead.
