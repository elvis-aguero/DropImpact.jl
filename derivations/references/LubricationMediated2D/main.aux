\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Comparisons of Coefficient of restitution $\alpha $, penetration depth $\delta $ and dimensionless contact time $\tau $, to Weber number (a,c,e) and Ohnesorge number (b,d,e) for a parameter sweep of values. The dimensionless parameter not plotted is indicated by the colour gradient on the opposite graph. Lubrication-mediated numerical results are presented by circles ($\bullet $), and triangles are used to indicate DNS results ($\triangle $) which correspond to a subset of the deformable parameter cases. The respective model subset is indicated by the circles being filled.}}{21}{figure.caption.9}\protected@file@percent }
\newlabel{fig: Comp We Oh}{{9}{21}{Comparisons of Coefficient of restitution $\alpha $, penetration depth $\delta $ and dimensionless contact time $\tau $, to Weber number (a,c,e) and Ohnesorge number (b,d,e) for a parameter sweep of values. The dimensionless parameter not plotted is indicated by the colour gradient on the opposite graph. Lubrication-mediated numerical results are presented by circles ($\bullet $), and triangles are used to indicate DNS results ($\triangle $) which correspond to a subset of the deformable parameter cases. The respective model subset is indicated by the circles being filled}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Coefficient of restitution $\alpha $, penetration depth $\delta $ and dimensionless contact time $\tau $ plotted against Reynolds number $Re$. The colours correspond to varying Weber numbers $W\!e$, with connected lines corresponding to fixed Ohnesorge numbers $Oh$. Here we have included the solid model results by the squares ($\square $), and as before circles ($\bullet $) denote the deformable model results, with solid lines highlighting their DNS counterpart results shown with triangles ($\blacktriangle $).}}{22}{figure.caption.10}\protected@file@percent }
\newlabel{fig: Reynolds}{{10}{22}{Coefficient of restitution $\alpha $, penetration depth $\delta $ and dimensionless contact time $\tau $ plotted against Reynolds number $Re$. The colours correspond to varying Weber numbers $W\!e$, with connected lines corresponding to fixed Ohnesorge numbers $Oh$. Here we have included the solid model results by the squares ($\square $), and as before circles ($\bullet $) denote the deformable model results, with solid lines highlighting their DNS counterpart results shown with triangles ($\blacktriangle $)}{figure.caption.10}{}}
